# Tabletop Organizer Environment Variables
# Copy this file to .env and fill in your values
# SECURITY: Never commit .env to version control

# Supabase Configuration
# Get these values from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat Configuration (Optional - for subscriptions)
# Get your API key from: RevenueCat Dashboard → Project Settings → API Keys
# iOS keys start with 'appl_' - other formats will be ignored
# Leave empty or omit if not using RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_KEY_HERE
